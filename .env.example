# Local example values only. No real secrets.
# Copy to .env; docker compose and the Makefile read it automatically.

# ============================================================
# HTTP
# ============================================================

HTTP_PORT=8080

# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=junglegaming
POSTGRES_PORT=5433

# The application connects with the least privilege role created by
# docker/postgres/01-app-role.sh; migrations use POSTGRES_USER, which owns the schema.
APP_DB_PASSWORD=jungle_app
DATABASE_URL=postgres://jungle_app:jungle_app@localhost:5433/junglegaming?sslmode=disable

# ============================================================
# PostgreSQL - integration tests
# ============================================================

POSTGRES_TEST_DB=junglegaming_test
POSTGRES_TEST_PORT=5434
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/junglegaming_test?sslmode=disable

# ============================================================
# Keycloak
# ============================================================

KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=junglegaming

# Issuer validated in tokens and where the signing keys are fetched from.
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/junglegaming
KEYCLOAK_JWKS_URL=http://localhost:8081/realms/junglegaming/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=junglegaming-api

# client_credentials test identities provisioned by keycloak/junglegaming-realm.json.
KEYCLOAK_PROVIDER_A_CLIENT_ID=provider-a
KEYCLOAK_PROVIDER_A_CLIENT_SECRET=provider-a-secret
KEYCLOAK_PROVIDER_B_CLIENT_ID=provider-b
KEYCLOAK_PROVIDER_B_CLIENT_SECRET=provider-b-secret
KEYCLOAK_INTERNAL_CLIENT_ID=internal-service
KEYCLOAK_INTERNAL_CLIENT_SECRET=internal-service-secret

# provider-a identity whose tokens expire after 1 second (expired token tests).
KEYCLOAK_SHORT_LIVED_CLIENT_ID=provider-a-short-lived
KEYCLOAK_SHORT_LIVED_CLIENT_SECRET=provider-a-short-lived-secret

# ============================================================
# AWS SQS (MiniStack)
# ============================================================

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENT_QUEUE_URL=http://localhost:4566/000000000000/integration-events.fifo

# Providers allowed to submit wagers through SQS (comma separated).
SQS_ALLOWED_PROVIDERS=provider-a,provider-b

# ============================================================
# Pending references (optional, Go durations)
# ============================================================

REFERENCE_RETRY_INITIAL_DELAY=5s
REFERENCE_RETRY_MAX_DELAY=5m
REFERENCE_TTL=24h
