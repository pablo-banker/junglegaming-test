{
  "realm": "junglegaming",
  "displayName": "Jungle Gaming",
  "enabled": true,
  "sslRequired": "external",

  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,

  "accessTokenLifespan": 300,

  "roles": {
    "realm": [
      {
        "name": "provider",
        "description": "Game provider service"
      },
      {
        "name": "internal",
        "description": "Trusted Jungle Gaming internal service"
      }
    ]
  },

  "clients": [
    {
      "clientId": "provider-a",
      "name": "Provider A",
      "description": "Machine-to-machine client for Provider A",

      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",

      "secret": "${KEYCLOAK_PROVIDER_A_CLIENT_SECRET}",

      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,

      "fullScopeAllowed": true,

      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "junglegaming-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "junglegaming-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },

    {
      "clientId": "provider-b",
      "name": "Provider B",
      "description": "Machine-to-machine client for Provider B",

      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",

      "secret": "${KEYCLOAK_PROVIDER_B_CLIENT_SECRET}",

      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,

      "fullScopeAllowed": true,

      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-b",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "junglegaming-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "junglegaming-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },

    {
      "clientId": "internal-service",
      "name": "Internal Service",
      "description": "Trusted Jungle Gaming internal service",

      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",

      "secret": "${KEYCLOAK_INTERNAL_CLIENT_SECRET}",

      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,

      "fullScopeAllowed": true,

      "protocolMappers": [
        {
          "name": "junglegaming-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "junglegaming-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "service-account-provider-a",
      "enabled": true,
      "serviceAccountClientId": "provider-a",
      "realmRoles": [
        "provider"
      ]
    },
    {
      "username": "service-account-provider-b",
      "enabled": true,
      "serviceAccountClientId": "provider-b",
      "realmRoles": [
        "provider"
      ]
    },
    {
      "username": "service-account-internal-service",
      "enabled": true,
      "serviceAccountClientId": "internal-service",
      "realmRoles": [
        "internal"
      ]
    }
  ]
}